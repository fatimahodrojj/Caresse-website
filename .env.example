# Copy this file to .env and fill in real values. Never commit .env.
# On Vercel, set the same variables in Project → Settings → Environment Variables.
# See docs/booking-setup.md for where each value comes from.

# Neon Postgres (added automatically by the Vercel ↔ Neon integration).
# Pooled connection, used by the app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection, used by Prisma migrations:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Resend (resend.com → API Keys, "Sending access" only).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Who receives new booking requests, and the sender (must be on the
# domain verified in Resend).
BOOKING_EMAIL_TO="caresseclinic@gmail.com"
BOOKING_EMAIL_FROM="Caresse Bookings <bookings@caresseclinic.com>"

# Random secret used to hash IP addresses for rate limiting
# (e.g. generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
RATE_LIMIT_SALT="change-me-to-a-long-random-string"
