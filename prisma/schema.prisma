// Database schema. Connection settings live in prisma.config.ts and .env.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentFor {
  CHILD
  SELF
}

/// The therapy the person is asking about (not a condition).
enum Service {
  SPEECH_THERAPY
  ABA_THERAPY
  OCCUPATIONAL_THERAPY
  PSYCHOMOTOR_SUPPORT
  NOT_SURE
}

enum TimeSlot {
  MORNING
  AFTERNOON
}

/// Language of the form the request was sent from (English or Arabic site).
enum Language {
  EN
  AR
}

enum RequestStatus {
  NEW
  CONTACTED
  APPROVED
  DECLINED
}

/// A request from the /book form. Requests only: no exact time is booked.
/// notes and the child's details may contain health information: never log
/// them (see CLAUDE.md, Privacy).
model AppointmentRequest {
  id             String         @id @default(cuid())
  appointmentFor AppointmentFor
  /// Parent's name when appointmentFor = CHILD, patient's name when SELF.
  firstName      String
  lastName       String
  /// Normalised: digits with an optional leading "+".
  phone          String
  /// Only set when appointmentFor = CHILD.
  childFirstName String?
  /// Whole years, 0-17. Only set when appointmentFor = CHILD.
  childAge       Int?
  service        Service
  timeSlot       TimeSlot
  notes          String?        @db.Text
  /// The site language the form was filled in; the clinic can reply in it.
  language       Language       @default(EN)
  status         RequestStatus  @default(NEW)
  /// When the person ticked the consent box (set on the server).
  consentAt      DateTime
  createdAt      DateTime       @default(now())

  @@index([status, createdAt])
  @@index([phone, createdAt])
}

/// Rate limiting only: a salted hash of the IP address, never the IP itself.
/// Rows older than 24 hours are deleted on each submission.
model SubmissionAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

/// An admin panel account. Only the argon2id hash of the password is stored.
model AdminUser {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  createdAt         DateTime       @default(now())
  passwordChangedAt DateTime       @default(now())
  sessions          AdminSession[]
}

/// A signed-in admin. The id is the SHA-256 of the random token in the
/// cookie, so a database leak does not reveal usable session tokens.
model AdminSession {
  id        String    @id
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Failed admin sign-in attempts, for rate limiting. Salted hashes only
/// (never the IP or the email itself). Rows older than 24 hours are deleted.
model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  emailHash String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([emailHash, createdAt])
}
